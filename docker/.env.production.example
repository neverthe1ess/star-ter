# OpenAI / Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ──────────────────────────────────────
# Next.js Web (빌드 ARG)
# ──────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://alleyai.shop
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
