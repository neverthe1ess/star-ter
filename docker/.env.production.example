# ──────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dev_board

# ──────────────────────────────────────
# NestJS API
# ──────────────────────────────────────
PORT=4000
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/dev_board
