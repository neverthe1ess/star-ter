model real_estate_bookmark {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String           @db.Uuid
  real_estate_id   String           @db.Uuid
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  real_estate_info real_estate_info @relation(fields: [real_estate_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_real_estate_bookmark_real_estate")
  user_info        user_info        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_real_estate_bookmark_user")

  @@unique([user_id, real_estate_id], map: "unique_user_real_estate")
}
