model user_info {
  id                   String                 @id @default(uuid()) @db.Uuid
  email                String                 @unique
  password             String
  nickname             String
  startup_capital      String?
  target_age_group     String?
  preferred_region     String?
  preferred_business_hours String?
  preferred_industry   String?
  on_boarding_completed Boolean @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  profile_image_id     String?                @db.Uuid @unique
  profile_image        imageInfo?             @relation("UserProfileImage", fields: [profile_image_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  bookmark             bookmark[]
  real_estate_bookmark real_estate_bookmark[]
  real_estate_info     real_estate_info[]
}

model bookmark {
  id             String    @id
  user_id        String    @db.Uuid
  commercialCode String
  commercialName String
  createdAt      DateTime  @default(now())
  user           user_info @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([user_id, commercialCode])
}
