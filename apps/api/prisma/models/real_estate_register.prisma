model real_estate_register {
  user_id           String    @db.Uuid
  address_name      String?   @db.VarChar(255)
  address_road_name String?   @db.VarChar(255)
  address_x         Decimal?  @db.Decimal(10, 7)
  address_y         Decimal?  @db.Decimal(10, 7)
  deposit           BigInt?
  monthly_rent      BigInt?
  maintenance_fee   BigInt?
  premium           BigInt?
  price_per_pyeong  BigInt?
  floor_info        String?   @db.VarChar(20)
  phone_number      String?   @db.VarChar(20)
  id                String    @id @db.Uuid
  area              Decimal?  @db.Decimal(10, 2)
  user_info         user_info @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
